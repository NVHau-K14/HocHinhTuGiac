@model QuadWeb.Models.ShapeDetailViewModel
@{
    ViewData["Title"] = $"{Model.Shape.Name} - Chi tiết bài học";
    var familyClass = Model.Shape.Family switch
    {
        "thang" => "family-thang",
        "binh-hanh" => "family-binhhanh",
        "dieu" => "family-dieu",
        _ => "family-goc"
    };
}

<div class="py-2">
    <!-- Điều hướng quay lại -->
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a href="/shapes" class="small" style="color: var(--color-ink); text-decoration: underline;">
            &larr; Quay lại danh sách các hình
        </a>
        <a href="/practice/@Model.Shape.Slug" class="btn-pen">
            Luyện tập hình này (5 câu)
        </a>
    </div>

    <!-- Tiêu đề hình -->
    <h1 class="mb-1" style="font-size: 2.5rem;">
        @Model.Shape.Name
    </h1>
    <p class="text-muted mb-4">@Model.Shape.ShortDescription</p>

    <!-- Bố cục 2 cột: Cột chính bài học (trái) và Cột phân cấp đồ thị IS_A (phải) -->
    <div class="row g-4">
        <!-- CỘT CHÍNH: HỌC LIỆU -->
        <div class="col-lg-8">
            <!-- Khung vẽ hình SVG trực quan -->
            <div class="shape-card @familyClass mb-4" style="max-width: 320px;">
                <div style="width: 100%; height: 180px; display: flex; align-items: center; justify-content: center;">
                    @await Html.PartialAsync("_ShapeSvg", Model.Shape.Slug)
                </div>
                <div class="shape-name">@Model.Shape.Name (Minh họa toán học)</div>
            </div>

            <!-- 1. Định nghĩa -->
            <section class="mb-4">
                <h2>1. Định nghĩa</h2>
                @if (Model.Definitions.Any())
                {
                    foreach (var def in Model.Definitions)
                    {
                        <div class="p-3 my-2" style="background-color: var(--color-paper); border-left: 3px solid var(--color-ink); border-radius: 4px;">
                            <p class="mb-1" style="font-size: 1.15rem;">
                                <span class="highlight">@def.Content</span>
                            </p>
                            @if (!string.IsNullOrEmpty(def.Note))
                            {
                                <p class="small text-muted mb-0"><em>@def.Note</em></p>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Chưa có định nghĩa cho loại hình này.</p>
                }

                @if (Model.IsKiteDefinitionNote)
                {
                    <div class="alert alert-warning small mt-2 p-2" role="alert" style="border: 1px dashed var(--color-margin); background-color: #fff9e6;">
                        <strong>Lưu ý quy ước bài học:</strong> Nhóm chọn định nghĩa hình diều là <em>"tứ giác có hai cặp cạnh kề bằng nhau"</em>. Theo định nghĩa bao hàm này, hình thoi là trường hợp đặc biệt của hình diều (vì hình thoi có bốn cạnh bằng nhau nên có hai cặp cạnh kề bằng nhau).
                    </div>
                }
            </section>

            <!-- 2. Tính chất trực tiếp -->
            <section class="mb-4">
                <h2>2. Tính chất trực tiếp</h2>
                @if (Model.DirectProperties.Any())
                {
                    <ul style="padding-left: 20px;">
                        @foreach (var prop in Model.DirectProperties)
                        {
                            <li style="margin-bottom: 8px;">
                                <strong>@prop.Content</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Không có tính chất riêng phát sinh tại mức này (toàn bộ tính chất được kế thừa từ các hình tổng quát hơn).</p>
                }
            </section>

            <!-- 3. Tính chất kế thừa qua quan hệ IS_A trong Neo4j (Tách riêng biệt theo brief) -->
            <section class="mb-4 p-3" style="background-color: #f3f8fc; border: 1.5px solid var(--color-grid); border-radius: 6px;">
                <h2 style="color: var(--color-ink); margin-top: 0;">
                    3. Tính chất kế thừa qua đồ thị IS_A
                </h2>
                <p class="small text-muted">
                    Tính chất được truy vấn tự động theo chuỗi quan hệ <code>(Shape)-[:IS_A*0..]->(Parent)-[:HAS_PROPERTY]->(Property)</code> trên cơ sở dữ liệu đồ thị Neo4j.
                </p>

                @if (Model.InheritedProperties.Any())
                {
                    <ul style="padding-left: 20px; margin-bottom: 0;">
                        @foreach (var prop in Model.InheritedProperties)
                        {
                            <li style="margin-bottom: 10px;">
                                <span>@prop.Content</span>
                                <div class="small mt-1">
                                    <span class="badge" style="background-color: var(--color-ink); color: #fff;">
                                        Kế thừa từ: @string.Join(", ", prop.Sources)
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Đây là hình gốc cao nhất của chủ đề (Tứ giác), không có thuộc tính kế thừa từ hình cha.</p>
                }
            </section>

            <!-- 4. Định lý -->
            @if (Model.Theorems.Any())
            {
                <section class="mb-4">
                    <h2>4. Định lý trọng tâm</h2>
                    @foreach (var theo in Model.Theorems)
                    {
                        <div class="p-3 my-2" style="border: 1px solid var(--color-grid); border-radius: 4px; background-color: var(--color-paper);">
                            <h3 style="font-size: 1.25rem; color: var(--color-ink); margin-bottom: 6px;">@theo.Title</h3>
                            <p class="mb-0" style="line-height: 1.6;">@theo.Content</p>
                        </div>
                    }
                </section>
            }

            <!-- 5. Dấu hiệu nhận biết -->
            @if (Model.Recognitions.Any())
            {
                <section class="mb-4">
                    <h2>5. Dấu hiệu nhận biết</h2>
                    <ul style="padding-left: 20px;">
                        @foreach (var recog in Model.Recognitions)
                        {
                            <li style="margin-bottom: 8px;">
                                @recog.Content
                            </li>
                        }
                    </ul>
                </section>
            }

            <!-- 6. Công thức tính toán (KaTeX) -->
            @if (Model.Formulas.Any())
            {
                <section class="mb-4">
                    <h2>6. Công thức toán học</h2>
                    @foreach (var form in Model.Formulas)
                    {
                        <div class="p-3 my-2" style="border: 1px solid var(--color-grid); border-radius: 4px; background-color: var(--color-paper);">
                            <div class="fw-bold mb-1" style="color: var(--color-ink);">@form.Name:</div>
                            <div class="katex-display-scroll my-2" style="font-size: 1.25rem;">
                                $$@form.Expression$$
                            </div>
                            @if (!string.IsNullOrEmpty(form.Note))
                            {
                                <div class="small text-muted">@form.Note</div>
                            }
                        </div>
                    }
                </section>
            }

            <!-- 7. Ví dụ minh họa -->
            @if (Model.Examples.Any())
            {
                <section class="mb-4">
                    <h2>7. Ví dụ minh họa</h2>
                    @foreach (var ex in Model.Examples)
                    {
                        <div class="p-3 my-2" style="border: 1px dashed var(--color-ink); border-radius: 4px; background-color: var(--color-paper);">
                            <h3 style="font-size: 1.25rem; margin-bottom: 6px;">@ex.Title</h3>
                            <p class="mb-2"><strong>Đề bài:</strong> @ex.Content</p>
                            <div class="p-2" style="background-color: #f7fafc; border-left: 3px solid #2E8B57; border-radius: 2px;">
                                <strong style="color: #2E8B57;">Lời giải:</strong>
                                <p class="mb-0 mt-1">@ex.Solution</p>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>

        <!-- CỘT PHỤ (BÊN PHẢI): PHÂN CẤP CÂY IS_A TRONG NEO4J -->
        <div class="col-lg-4">
            <div class="p-3 mb-4" style="background-color: var(--color-paper); border: 1.5px solid var(--color-grid); border-radius: 6px;">
                <h3 style="font-size: 1.35rem; color: var(--color-ink); border-bottom: 1px solid var(--color-grid); padding-bottom: 6px;">
                    Phân cấp quan hệ IS_A
                </h3>

                <!-- Hình cha (tổng quát hơn) -->
                <div class="mt-3">
                    <strong class="small text-muted d-block mb-1">Hình tổng quát trực tiếp (Hình cha):</strong>
                    @if (Model.Parents.Any())
                    {
                        <ul class="list-unstyled mb-3" style="padding-left: 0;">
                            @foreach (var parent in Model.Parents)
                            {
                                <li style="margin-bottom: 8px;">
                                    <span style="color: var(--color-margin); font-weight: bold;">&uarr;</span>
                                    <a href="/shape/@parent.Slug" style="color: var(--color-ink); font-weight: 600; text-decoration: underline;">
                                        @parent.Name
                                    </a>
                                    @if (!string.IsNullOrEmpty(parent.Condition))
                                    {
                                        <div class="small mt-1 ps-3" style="color: var(--color-pencil);">
                                            Để là @Model.Shape.Name cần thêm: <mark class="condition-highlight" style="font-size: 0.88em;">@parent.Condition</mark>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small text-muted mb-3"><em>Là hình tổng quát nhất (Tứ giác gốc).</em></p>
                    }
                </div>

                <!-- Hình con (đặc biệt hơn) -->
                <div class="mt-3">
                    <strong class="small text-muted d-block mb-1">Hình đặc biệt trực tiếp (Hình con):</strong>
                    @if (Model.Children.Any())
                    {
                        <ul class="list-unstyled mb-0" style="padding-left: 0;">
                            @foreach (var child in Model.Children)
                            {
                                <li style="margin-bottom: 8px;">
                                    <span style="color: #2E8B57; font-weight: bold;">&darr;</span>
                                    <a href="/shape/@child.Slug" style="color: var(--color-ink); font-weight: 600; text-decoration: underline;">
                                        @child.Name
                                    </a>
                                    @if (!string.IsNullOrEmpty(child.Condition))
                                    {
                                        <div class="small mt-1 ps-3" style="color: var(--color-pencil);">
                                            Thành @child.Name khi: <mark class="condition-highlight" style="font-size: 0.88em;">@child.Condition</mark>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small text-muted mb-0"><em>Là hình đặc biệt nhất ở nhánh này.</em></p>
                    }
                </div>
            </div>

            <!-- Khung Luyện tập -->
            <div class="p-3 text-center" style="background-color: #fafcf0; border: 1.5px dashed #2E8B57; border-radius: 6px;">
                <h4 style="color: #2E8B57; margin-bottom: 8px;">Củng cố kiến thức</h4>
                <p class="small text-muted mb-3">
                    Làm ngay 5 câu hỏi trắc nghiệm (lý thuyết, tính toán, nhận biết) về @Model.Shape.Name.
                </p>
                <a href="/practice/@Model.Shape.Slug" class="btn-pen" style="background-color: #2E8B57; border-color: #2E8B57; width: 100%;">
                    Bắt đầu luyện tập
                </a>
            </div>
        </div>
    </div>
</div>
