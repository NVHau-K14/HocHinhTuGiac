@model List<QuadWeb.Models.Shape>
@{
    ViewData["Title"] = "Khám phá 8 loại tứ giác - Bài học hình học";
}

<div class="py-2">
    <!-- Điều hướng nhanh -->
    <div class="mb-3">
        <a href="/" class="small" style="color: var(--color-ink); text-decoration: underline;">&larr; Về trang chủ</a>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1" style="font-size: 2.2rem;">Khám phá các loại tứ giác</h1>
            <p class="mb-0 text-muted">
                Tìm hiểu định nghĩa, tính chất trực tiếp và tính chất kế thừa trên CSDL đồ thị Neo4j.
            </p>
        </div>
        <div>
            <a href="/#graph-section" id="btnOpenGraph" class="btn-pen-outline">
                Xem sơ đồ quan hệ
            </a>
        </div>
    </div>

    <!-- Lưới 8 hình -->
    <div class="shape-card-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var shape in Model)
            {
                var familyClass = shape.Family switch
                {
                    "thang" => "family-thang",
                    "binh-hanh" => "family-binhhanh",
                    "dieu" => "family-dieu",
                    _ => "family-goc"
                };

                <a href="/shape/@shape.Slug" class="shape-card @familyClass" title="Xem chi tiết @shape.Name">
                    <div style="width: 100%; height: 140px; display: flex; align-items: center; justify-content: center;">
                        @await Html.PartialAsync("_ShapeSvg", shape.Slug)
                    </div>
                    <h3 class="shape-name">@shape.Name</h3>
                    <p class="shape-desc">@shape.ShortDescription</p>
                </a>
            }
        }
        else
        {
            <div class="p-3 text-muted">Không có dữ liệu hình trong hệ thống.</div>
        }
    </div>
</div>
