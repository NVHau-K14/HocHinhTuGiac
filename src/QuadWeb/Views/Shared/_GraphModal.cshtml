<!-- SƠ ĐỒ QUAN HỆ PHÂN CẤP IS_A (VIS-NETWORK MODAL) -->
<div id="graphModal" class="graph-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="graphModalTitle">
    <div class="graph-modal-container">
        <!-- Tiêu đề & Nút đóng -->
        <div class="d-flex justify-content-between align-items-start mb-2 border-bottom pb-2 gap-2">
            <div>
                <h2 id="graphModalTitle" class="mb-1" style="font-size: 1.75rem; color: var(--color-ink);">
                    Sơ đồ quan hệ phân cấp các hình tứ giác
                </h2>
                <p id="graphModalDesc" class="small text-muted mb-0" style="line-height: 1.5;">
                    Mũi tên đi từ hình tổng quát đến hình đặc biệt. Chữ trên mũi tên là điều kiện cần thêm. Bấm vào mũi tên để xem vì sao hai hình có quan hệ; bấm vào hình để mở bài học.
                </p>
            </div>
            <button type="button" class="btn-pen-outline flex-shrink-0" id="btnCloseGraph" aria-label="Đóng sơ đồ" style="white-space: nowrap; min-width: 125px; padding: 6px 14px;">
                ✕ Đóng sơ đồ
            </button>
        </div>

        <!-- Bộ chọn 2 chiều đọc (Mục 3.2 PROMPT_SUA_SO_DO_v2_3) -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div class="graph-direction-toggle d-inline-flex p-1" style="background-color: var(--color-paper); border: 1.5px solid var(--color-grid); border-radius: 6px;" role="radiogroup" aria-label="Chọn chiều đọc sơ đồ">
                <button type="button" class="btn-segmented active" id="btnModeCondition" data-mode="condition" role="radio" aria-checked="true">
                    &darr; Thêm điều kiện (Mặc định)
                </button>
                <button type="button" class="btn-segmented" id="btnModeIsA" data-mode="is_a" role="radio" aria-checked="false">
                    &uarr; Theo quan hệ IS_A
                </button>
            </div>
            <div class="small text-muted d-flex align-items-center gap-2" id="graphModeBadge">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--color-ink);"></span>
                <span id="graphModeHint">Đang xem: Hình cha &rarr; Hình con (kèm điều kiện)</span>
            </div>
        </div>

        <!-- Trạng thái tải -->
        <div id="graphLoading" class="py-5 text-center" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-2 text-muted">Đang kết nối Neo4j và khởi tạo sơ đồ...</p>
        </div>

        <!-- Trạng thái lỗi -->
        <div id="graphError" class="alert alert-danger my-3 p-3" style="display: none;">
            <div class="d-flex align-items-center justify-content-between">
                <span>Không tải được sơ đồ quan hệ. Vui lòng kiểm tra dịch vụ CSDL và thử lại sau.</span>
                <button type="button" class="btn btn-sm btn-danger" id="btnRetryGraph">Thử lại</button>
            </div>
        </div>

        <!-- Khung chứa Canvas và Panel chi tiết quan hệ -->
        <div class="graph-viewport-wrapper position-relative" style="overflow: hidden; border: 1.5px solid var(--color-grid); border-radius: 6px; background-color: var(--color-paper);">
            <!-- Vùng vẽ canvas đồ thị vis-network (chiều cao clamp theo mục 3.3) -->
            <div id="visNetworkContainer" class="vis-canvas-wrapper" style="height: clamp(420px, 68vh, 680px); width: 100%;"></div>

            <!-- Panel thông tin quan hệ khi bấm vào cạnh (Mục 4 PROMPT_SUA_SO_DO_v2_3) -->
            <aside id="edgeDetailPanel" class="edge-detail-panel" style="display: none;" role="region" aria-live="polite" aria-label="Thông tin quan hệ hai hình" tabindex="-1">
                <div class="edge-panel-header d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <span class="fw-bold small" style="color: var(--color-ink); text-transform: uppercase; letter-spacing: 0.5px;">Chi tiết quan hệ</span>
                    <button type="button" class="btn-pen-outline btn-sm" id="btnCloseEdgePanel" aria-label="Đóng bảng thông tin" style="padding: 2px 10px; font-size: 0.82rem;">
                        ✕ Đóng
                    </button>
                </div>

                <div id="edgePanelLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="small text-muted mt-2">Đang tải thông tin quan hệ...</div>
                </div>

                <div id="edgePanelError" class="alert alert-danger p-2 small mb-0" style="display: none;">
                    <div class="mb-2" id="edgePanelErrorMsg">Không tải được thông tin quan hệ này.</div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnRetryEdgeDetail">Thử lại</button>
                </div>

                <div id="edgePanelContent" style="display: none;">
                    <!-- 1. Tiêu đề: Tên hai hình -->
                    <h3 id="panelEdgeTitle" class="mb-1" style="font-size: 1.35rem; color: var(--color-ink); font-family: var(--font-hand);"></h3>

                    <!-- 2. Quan hệ: Hình con là trường hợp đặc biệt của Hình cha -->
                    <p id="panelEdgeRelation" class="small mb-1" style="color: var(--color-pencil); line-height: 1.5;"></p>
                    <div class="small text-muted mb-3" id="panelEdgeRoleBadge" style="font-size: 0.8rem;"></div>

                    <!-- 3. Thêm điều kiện: Khối nổi bật tô dạ quang -->
                    <div class="p-2 px-3 mb-3" style="background-color: #FFF9DB; border-left: 4px solid #FFE66D; border-radius: 4px;">
                        <div class="small text-muted mb-1" style="font-weight: 600;">Thêm điều kiện:</div>
                        <div id="panelEdgeFormula" style="font-size: 0.95rem; color: var(--color-ink); font-weight: 500; line-height: 1.5;"></div>
                    </div>

                    <!-- 4. Vì sao có quan hệ cha - con & Định nghĩa hai hình -->
                    <div class="mb-3" id="panelSectionReason">
                        <div class="fw-bold small mb-1" style="color: var(--color-ink);">Vì sao có quan hệ cha–con:</div>
                        <p id="panelEdgeReasonText" class="small mb-2" style="line-height: 1.55; color: var(--color-pencil); background: #FAFBFD; padding: 8px 10px; border-radius: 4px; border: 1px dashed var(--color-grid);"></p>

                        <div class="d-flex flex-column gap-2 mt-2">
                            <div id="panelBoxDefChild" class="p-2" style="background: #FAFCFD; border: 1px solid var(--color-grid); border-radius: 4px;">
                                <strong class="d-block small mb-1" style="color: var(--color-ink);" id="panelTitleDefChild">Định nghĩa hình con:</strong>
                                <div class="small text-muted" id="panelTextDefChild" style="line-height: 1.45;"></div>
                            </div>
                            <div id="panelBoxDefParent" class="p-2" style="background: #FAFCFD; border: 1px solid var(--color-grid); border-radius: 4px;">
                                <strong class="d-block small mb-1" style="color: var(--color-ink);" id="panelTitleDefParent">Định nghĩa hình cha:</strong>
                                <div class="small text-muted" id="panelTextDefParent" style="line-height: 1.45;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Tính chất thừa hưởng -->
                    <div class="mb-3" id="panelSectionProps">
                        <div class="fw-bold small mb-1 d-flex justify-content-between align-items-center" style="color: var(--color-ink);">
                            <span>Tính chất thừa hưởng:</span>
                            <span class="badge" style="background: var(--color-grid); color: var(--color-ink);" id="panelPropsCountBadge">0</span>
                        </div>
                        <ul class="list-unstyled mb-1 small" id="panelPropsList" style="padding-left: 0;"></ul>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none mt-1" id="btnToggleProps" style="font-size: 0.82rem; color: var(--color-ink); display: none;">
                            Xem thêm tính chất &darr;
                        </button>
                    </div>

                    <!-- 6. Hành động -->
                    <div class="d-flex flex-column gap-2 pt-2 border-top">
                        <a href="#" id="btnPanelChildLesson" class="btn-pen-outline btn-sm text-center" style="font-size: 0.85rem;">Mở bài học hình con</a>
                        <a href="#" id="btnPanelParentLesson" class="btn-pen-outline btn-sm text-center" style="font-size: 0.85rem;">Mở bài học hình cha</a>
                        <a href="#" id="btnPanelCompare" class="btn-pen btn-sm text-center" style="font-size: 0.85rem; background-color: var(--color-ink); color: #fff;">So sánh hai hình này &rarr;</a>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Chú thích (Legend) chuẩn mục 3.3 -->
        <div class="graph-legend d-flex flex-wrap align-items-center gap-2 gap-sm-3 p-2 px-3 mt-2 mb-2" style="background-color: var(--color-paper); border: 1px solid var(--color-grid); border-radius: 4px; font-size: 0.85rem;">
            <span class="fw-bold" style="color: var(--color-ink);">Chú thích họ hình:</span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #E6DDF5; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình thang
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #D8F0E4; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình bình hành
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #FBE0E8; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình diều
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #FAFCFD; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Tứ giác gốc
            </span>
            <span class="d-inline-flex align-items-center gap-1 ms-sm-auto">
                <span style="padding: 1px 6px; background: #FFE66D; color: #1F3A93; font-weight: 600; border-radius: 2px; font-size: 0.8rem; border: 1px solid #e0c840;">+ Điều kiện</span>
                <span style="color: var(--color-pencil);">Nhãn vàng: điều kiện cần thêm</span>
            </span>
        </div>

        <!-- Hướng dẫn tương tác & Danh sách phân cấp hỗ trợ Mobile -->
        <div class="mt-3 p-3" style="background-color: #f6fafe; border: 1px dashed var(--color-grid); border-radius: 6px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="small" style="color: var(--color-ink);">Cây phân cấp 8 hình (Tầng 0 &rarr; Tầng 4):</strong>
                <span class="small text-muted d-none d-sm-inline">Có thể kéo chuột để di chuyển hoặc cuộn chuột để phóng to/thu nhỏ</span>
            </div>
            <div class="small" style="line-height: 1.7; color: var(--color-pencil);">
                <div>&bull; <strong>Tầng 0 (Gốc cao nhất):</strong> <a href="/shape/tu-giac" style="color: var(--color-ink); font-weight: 600;">Tứ giác</a> (tổng 4 góc = 360°)</div>
                <div>&bull; <strong>Tầng 1:</strong> <a href="/shape/hinh-thang" style="color: var(--color-ink); font-weight: 600;">Hình thang</a> (có cặp cạnh đối song song) &bull; <a href="/shape/hinh-dieu" style="color: var(--color-ink); font-weight: 600;">Hình diều</a> (hai cặp cạnh kề bằng nhau)</div>
                <div>&bull; <strong>Tầng 2:</strong> <a href="/shape/hinh-thang-can" style="color: var(--color-ink); font-weight: 600;">Hình thang cân</a> (IS_A Hình thang) &bull; <a href="/shape/hinh-binh-hanh" style="color: var(--color-ink); font-weight: 600;">Hình bình hành</a> (IS_A Hình thang)</div>
                <div>&bull; <strong>Tầng 3:</strong> <a href="/shape/hinh-chu-nhat" style="color: var(--color-ink); font-weight: 600;">Hình chữ nhật</a> (IS_A Bình hành &amp; Thang cân) &bull; <a href="/shape/hinh-thoi" style="color: var(--color-ink); font-weight: 600;">Hình thoi</a> (IS_A Bình hành &amp; Diều)</div>
                <div>&bull; <strong>Tầng 4 (Đặc biệt nhất):</strong> <a href="/shape/hinh-vuong" style="color: var(--color-ink); font-weight: 600;">Hình vuông</a> (IS_A Chữ nhật &amp; Thoi)</div>
            </div>
        </div>
    </div>
</div>
