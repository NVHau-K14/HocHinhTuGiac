<!-- SƠ ĐỒ QUAN HỆ PHÂN CẤP IS_A (VIS-NETWORK MODAL) -->
<div id="graphModal" class="graph-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="graphModalTitle">
    <div class="graph-modal-container">
        <!-- Tiêu đề & Nút đóng -->
        <div class="d-flex justify-content-between align-items-start mb-2 border-bottom pb-2 gap-2">
            <div>
                <h2 id="graphModalTitle" class="mb-1" style="font-size: 1.75rem; color: var(--color-ink);">
                    Sơ đồ quan hệ phân cấp các hình tứ giác
                </h2>
                <p id="graphModalDesc" class="small text-muted mb-0" style="line-height: 1.5;">
                    Mũi tên đi từ hình tổng quát đến hình đặc biệt. Chữ trên mũi tên là điều kiện cần thêm. Bấm vào mũi tên để xem vì sao hai hình có quan hệ; bấm vào hình để mở bài học.
                </p>
            </div>
            <button type="button" class="btn-pen-outline flex-shrink-0" id="btnCloseGraph" aria-label="Đóng sơ đồ" style="white-space: nowrap; min-width: 125px; padding: 6px 14px;">
                ✕ Đóng sơ đồ
            </button>
        </div>

        <!-- Trạng thái tải -->
        <div id="graphLoading" class="py-5 text-center" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-2 text-muted">Đang kết nối Neo4j và khởi tạo sơ đồ...</p>
        </div>

        <!-- Trạng thái lỗi -->
        <div id="graphError" class="alert alert-danger my-3 p-3" style="display: none;">
            <div class="d-flex align-items-center justify-content-between">
                <span>Không tải được sơ đồ quan hệ. Vui lòng kiểm tra dịch vụ CSDL và thử lại sau.</span>
                <button type="button" class="btn btn-sm btn-danger" id="btnRetryGraph">Thử lại</button>
            </div>
        </div>

        <!-- Vùng vẽ canvas đồ thị vis-network (chiều cao clamp theo mục 3.3) -->
        <div id="visNetworkContainer" class="vis-canvas-wrapper" style="height: clamp(420px, 68vh, 680px); width: 100%; border: 1.5px solid var(--color-grid); border-radius: 6px; background-color: var(--color-paper); position: relative;"></div>

        <!-- Chú thích (Legend) chuẩn mục 3.3 -->
        <div class="graph-legend d-flex flex-wrap align-items-center gap-2 gap-sm-3 p-2 px-3 mt-2 mb-2" style="background-color: var(--color-paper); border: 1px solid var(--color-grid); border-radius: 4px; font-size: 0.85rem;">
            <span class="fw-bold" style="color: var(--color-ink);">Chú thích họ hình:</span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #E6DDF5; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình thang
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #D8F0E4; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình bình hành
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #FBE0E8; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Họ hình diều
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width: 14px; height: 14px; background: #FAFCFD; border: 1.5px solid #1F3A93; border-radius: 2px; display: inline-block;"></span> Tứ giác gốc
            </span>
            <span class="d-inline-flex align-items-center gap-1 ms-sm-auto">
                <span style="padding: 1px 6px; background: #FFE66D; color: #1F3A93; font-weight: 600; border-radius: 2px; font-size: 0.8rem; border: 1px solid #e0c840;">+ Điều kiện</span>
                <span style="color: var(--color-pencil);">Nhãn vàng: điều kiện cần thêm</span>
            </span>
        </div>

        <!-- Hướng dẫn tương tác & Danh sách phân cấp hỗ trợ Mobile -->
        <div class="mt-3 p-3" style="background-color: #f6fafe; border: 1px dashed var(--color-grid); border-radius: 6px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="small" style="color: var(--color-ink);">Cây phân cấp 8 hình (Tầng 0 &rarr; Tầng 4):</strong>
                <span class="small text-muted d-none d-sm-inline">Có thể kéo chuột để di chuyển hoặc cuộn chuột để phóng to/thu nhỏ</span>
            </div>
            <div class="small" style="line-height: 1.7; color: var(--color-pencil);">
                <div>&bull; <strong>Tầng 0 (Gốc cao nhất):</strong> <a href="/shape/tu-giac" style="color: var(--color-ink); font-weight: 600;">Tứ giác</a> (tổng 4 góc = 360°)</div>
                <div>&bull; <strong>Tầng 1:</strong> <a href="/shape/hinh-thang" style="color: var(--color-ink); font-weight: 600;">Hình thang</a> (có cặp cạnh đối song song) &bull; <a href="/shape/hinh-dieu" style="color: var(--color-ink); font-weight: 600;">Hình diều</a> (hai cặp cạnh kề bằng nhau)</div>
                <div>&bull; <strong>Tầng 2:</strong> <a href="/shape/hinh-thang-can" style="color: var(--color-ink); font-weight: 600;">Hình thang cân</a> (IS_A Hình thang) &bull; <a href="/shape/hinh-binh-hanh" style="color: var(--color-ink); font-weight: 600;">Hình bình hành</a> (IS_A Hình thang)</div>
                <div>&bull; <strong>Tầng 3:</strong> <a href="/shape/hinh-chu-nhat" style="color: var(--color-ink); font-weight: 600;">Hình chữ nhật</a> (IS_A Bình hành &amp; Thang cân) &bull; <a href="/shape/hinh-thoi" style="color: var(--color-ink); font-weight: 600;">Hình thoi</a> (IS_A Bình hành &amp; Diều)</div>
                <div>&bull; <strong>Tầng 4 (Đặc biệt nhất):</strong> <a href="/shape/hinh-vuong" style="color: var(--color-ink); font-weight: 600;">Hình vuông</a> (IS_A Chữ nhật &amp; Thoi)</div>
            </div>
        </div>
    </div>
</div>
