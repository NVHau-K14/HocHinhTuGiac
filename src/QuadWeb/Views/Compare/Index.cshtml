@model QuadWeb.Models.CompareViewModel
@{
    ViewData["Title"] = "So sánh hai hình tứ giác";
    var s1 = Model.Shape1?.Shape;
    var s2 = Model.Shape2?.Shape;
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <a href="/" class="text-decoration-none small" style="color: var(--color-pencil);">&larr; Về trang chủ</a>
        <span class="text-muted">|</span>
        <span class="small text-muted">Đối chiếu kiến thức</span>
    </div>
    <h1 style="color: var(--color-ink); margin-bottom: 8px;">
        <span style="color: var(--color-margin);">✎</span> So sánh & Đối chiếu hai hình tứ giác
    </h1>
    <p style="color: var(--color-pencil); font-size: 1.05rem;">
        Khám phá mối quan hệ kế thừa phả hệ, điểm tương đồng và sự khác biệt về tính chất giữa hai hình bất kỳ.
    </p>
</div>

<!-- Form chọn 2 hình để so sánh -->
<div class="p-3 mb-4" style="background-color: #FFFFFF; border: 1.5px solid var(--color-ink); border-radius: 8px; box-shadow: 3px 3px 0px rgba(31, 58, 147, 0.15);">
    <form method="get" action="/compare" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-bold" style="color: var(--color-ink); font-family: 'Patrick Hand', cursive; font-size: 1.25rem;">
                Chọn Hình thứ nhất:
            </label>
            <select name="shape1" class="form-select" style="font-family: 'Patrick Hand', cursive; font-size: 1.2rem; border: 1.5px solid var(--color-ink);">
                @foreach (var sh in Model.AllShapes)
                {
                    <option value="@sh.Slug" selected="@(sh.Slug == s1?.Slug)">@sh.Name</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label fw-bold" style="color: var(--color-ink); font-family: 'Patrick Hand', cursive; font-size: 1.25rem;">
                Chọn Hình thứ hai:
            </label>
            <select name="shape2" class="form-select" style="font-family: 'Patrick Hand', cursive; font-size: 1.2rem; border: 1.5px solid var(--color-ink);">
                @foreach (var sh in Model.AllShapes)
                {
                    <option value="@sh.Slug" selected="@(sh.Slug == s2?.Slug)">@sh.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-pen w-100" style="font-size: 1.15rem; padding: 7px 12px;">
                So sánh ✎
            </button>
        </div>
    </form>
</div>

@if (s1 != null && s2 != null)
{
    <!-- Khung Mối quan hệ phả hệ trong đồ thị -->
    <div class="p-3 mb-4" style="background-color: var(--color-highlight); border: 2px solid var(--color-ink); border-radius: 6px;">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span style="font-size: 1.4rem;">🌳</span>
            <h4 style="font-family: 'Patrick Hand', cursive; font-size: 1.45rem; color: var(--color-ink); margin-bottom: 0;">
                Mối quan hệ hình học trong Đồ thị Tứ giác:
            </h4>
        </div>
        <p class="mb-2" style="font-size: 1.05rem; color: var(--color-text); line-height: 1.5;">
            @Model.RelationshipDescription
        </p>
        <div class="small" style="color: var(--color-pencil);">
            Tổ tiên chung gần nhất: <strong style="color: var(--color-ink);">@Model.LowestCommonAncestorName</strong>
        </div>
    </div>

    <!-- Bảng so sánh 2 cột trực quan -->
    <div class="row g-3 mb-4">
        <!-- Cột Hình 1 -->
        <div class="col-md-6">
            <div class="p-3 h-100" style="background-color: #FFFFFF; border: 1.5px solid var(--color-ink); border-radius: 6px; box-shadow: 2px 2px 0px rgba(0,0,0,0.05);">
                <div class="text-center mb-3">
                    <div style="max-width: 160px; margin: 0 auto;">
                        @await Html.PartialAsync("_ShapeSvg", s1.Slug)
                    </div>
                    <h3 style="font-family: 'Patrick Hand', cursive; color: var(--color-ink); font-size: 1.7rem; margin-top: 8px; margin-bottom: 2px;">
                        @s1.Name
                    </h3>
                    <span class="small text-muted">@s1.ShortDescription</span>
                </div>

                <div class="mb-3">
                    <strong style="color: var(--color-ink); font-family: 'Patrick Hand', cursive; font-size: 1.2rem;">Định nghĩa:</strong>
                    <ul class="entry-list mt-1">
                        @foreach (var def in Model.Shape1!.Definitions)
                        {
                            <li style="font-size: 0.95rem;">@def.Content</li>
                        }
                    </ul>
                </div>

                <div>
                    <strong style="color: var(--color-margin); font-family: 'Patrick Hand', cursive; font-size: 1.2rem;">
                        Tính chất riêng biệt của @s1.Name:
                    </strong>
                    @if (Model.UniqueProperties1.Any())
                    {
                        <ul class="entry-list mt-1">
                            @foreach (var prop in Model.UniqueProperties1)
                            {
                                <li style="font-size: 0.95rem;">@prop.Content</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small text-muted fst-italic">Không có tính chất riêng so với @s2.Name (hình con kế thừa toàn bộ).</p>
                    }
                </div>
            </div>
        </div>

        <!-- Cột Hình 2 -->
        <div class="col-md-6">
            <div class="p-3 h-100" style="background-color: #FFFFFF; border: 1.5px solid var(--color-ink); border-radius: 6px; box-shadow: 2px 2px 0px rgba(0,0,0,0.05);">
                <div class="text-center mb-3">
                    <div style="max-width: 160px; margin: 0 auto;">
                        @await Html.PartialAsync("_ShapeSvg", s2.Slug)
                    </div>
                    <h3 style="font-family: 'Patrick Hand', cursive; color: var(--color-ink); font-size: 1.7rem; margin-top: 8px; margin-bottom: 2px;">
                        @s2.Name
                    </h3>
                    <span class="small text-muted">@s2.ShortDescription</span>
                </div>

                <div class="mb-3">
                    <strong style="color: var(--color-ink); font-family: 'Patrick Hand', cursive; font-size: 1.2rem;">Định nghĩa:</strong>
                    <ul class="entry-list mt-1">
                        @foreach (var def in Model.Shape2!.Definitions)
                        {
                            <li style="font-size: 0.95rem;">@def.Content</li>
                        }
                    </ul>
                </div>

                <div>
                    <strong style="color: var(--color-margin); font-family: 'Patrick Hand', cursive; font-size: 1.2rem;">
                        Tính chất riêng biệt của @s2.Name:
                    </strong>
                    @if (Model.UniqueProperties2.Any())
                    {
                        <ul class="entry-list mt-1">
                            @foreach (var prop in Model.UniqueProperties2)
                            {
                                <li style="font-size: 0.95rem;">@prop.Content</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small text-muted fst-italic">Không có tính chất riêng so với @s1.Name (hình con kế thừa toàn bộ).</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Khung Tính chất chung mà cả hai cùng sở hữu -->
    <div class="p-3 mb-4" style="background-color: #FFFFFF; border: 1.5px solid var(--color-grid); border-left: 4px solid var(--color-ink); border-radius: 6px;">
        <h4 style="font-family: 'Patrick Hand', cursive; color: var(--color-ink); font-size: 1.4rem; margin-bottom: 8px;">
            🤝 Điểm tương đồng: Các tính chất mà cả @s1.Name và @s2.Name cùng sở hữu:
        </h4>
        @if (Model.CommonProperties.Any())
        {
            <ul class="entry-list mb-0">
                @foreach (var prop in Model.CommonProperties)
                {
                    <li>@prop.Content</li>
                }
            </ul>
        }
        else
        {
            <p class="small text-muted mb-0">Chưa ghi nhận tính chất chung trực tiếp ngoài các tính chất cơ bản của tứ giác.</p>
        }
    </div>

    <!-- Đối chiếu công thức tính toán -->
    <div class="p-3 mb-4" style="background-color: var(--color-paper); border: 1.5px solid var(--color-grid); border-radius: 6px;">
        <h4 style="font-family: 'Patrick Hand', cursive; color: var(--color-ink); font-size: 1.4rem; margin-bottom: 12px;">
            📐 Đối chiếu công thức diện tích & chu vi:
        </h4>
        <div class="row g-3">
            <div class="col-md-6">
                <strong>Công thức của @s1.Name:</strong>
                <ul class="list-unstyled mt-2">
                    @foreach (var f in Model.Shape1!.Formulas)
                    {
                        <li class="mb-2">
                            <span>@f.Name:</span> <code>@f.Expression</code>
                        </li>
                    }
                </ul>
            </div>
            <div class="col-md-6">
                <strong>Công thức của @s2.Name:</strong>
                <ul class="list-unstyled mt-2">
                    @foreach (var f in Model.Shape2!.Formulas)
                    {
                        <li class="mb-2">
                            <span>@f.Name:</span> <code>@f.Expression</code>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
